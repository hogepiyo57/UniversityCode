{
  "name": "university-code-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:build && vite build",
    "preview": "vite preview",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/build-data.mjs --validate-only",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "iconv-lite": "^0.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
